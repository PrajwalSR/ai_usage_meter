*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
Cache.db*

# Never commit real usage data or AI session logs
*.jsonl
claude.json
claude-live.json
last-invoked.json
claude-web.json
codex-web.json
*-raw.json
debug.log
